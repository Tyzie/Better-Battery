#!/usr/bin/env bash
set -euo pipefail
DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=../lib/common.sh
source "$DIR/lib/common.sh"

PID_FILE="$STATE_DIR/sleep-monitor.pid"
if [ -r "$PID_FILE" ]; then
  old=$(cat "$PID_FILE" 2>/dev/null || true)
  if [ -n "$old" ] && [ -r "/proc/$old/cmdline" ] && tr '\0' ' ' < "/proc/$old/cmdline" | grep -q 'battery-sleep-monitor'; then
    exit 0
  fi
fi
printf '%s\n' "$$" > "$PID_FILE"

snapshot_sleep() {
  local bat cap en status ac now iso
  bat=$(battery_path || true)
  [ -n "$bat" ] || return 0
  cap=$(read_sys "$bat/capacity" 0)
  en=$(energy_uwh "$bat" energy_now charge_now)
  status=$(read_sys "$bat/status" Unknown)
  ac=$(ac_online)
  now=$(date +%s)
  iso=$(date -Iseconds)
  jq -cn --argjson ts "$now" --arg iso "$iso" --argjson cap "$cap" \
    --argjson energy "$en" --arg status "$status" --argjson ac "$ac" \
    '{ts:$ts,iso:$iso,cap:$cap,energy:$energy,status:$status,ac:$ac}' > "$PENDING_SLEEP"
}

record_sleep() {
  [ -r "$PENDING_SLEEP" ] || return 0
  local pre pre_ts pre_cap pre_en pre_ac pre_iso
  pre=$(cat "$PENDING_SLEEP")
  pre_ts=$(jq -r '.ts // 0' <<<"$pre")
  pre_cap=$(jq -r '.cap // 0' <<<"$pre")
  pre_en=$(jq -r '.energy // 0' <<<"$pre")
  pre_ac=$(jq -r '.ac // 0' <<<"$pre")
  pre_iso=$(jq -r '.iso // ""' <<<"$pre")

  local bat cap en status ac now iso
  bat=$(battery_path || true)
  if [ -z "$bat" ]; then
    rm -f "$PENDING_SLEEP"
    return 0
  fi
  cap=$(read_sys "$bat/capacity" 0)
  en=$(energy_uwh "$bat" energy_now charge_now)
  status=$(read_sys "$bat/status" Unknown)
  ac=$(ac_online)
  now=$(date +%s)
  iso=$(date -Iseconds)

  if [ "$pre_ac" = "1" ] && [ "$ac" = "1" ]; then
    rm -f "$PENDING_SLEEP"
    return 0
  fi

  local dur=$((now - pre_ts))
  [ "$dur" -lt 30 ] && { rm -f "$PENDING_SLEEP"; return 0; }

  local drop_cap drop_wh draw_w
  drop_cap=$(awk -v a="$pre_cap" -v b="$cap" 'BEGIN{d=a-b; if(d<0)d=0; printf "%.2f", d}')
  drop_wh=$(awk -v a="$pre_en" -v b="$en" 'BEGIN{d=(a-b)/1000000; if(d<0)d=0; printf "%.3f", d}')
  draw_w=$(awk -v wh="$drop_wh" -v s="$dur" 'BEGIN{if(s>0) printf "%.3f", wh*3600/s; else print "0.000"}')

  jq -cn \
    --arg startIso "$pre_iso" \
    --arg endIso "$iso" \
    --argjson durationSec "$dur" \
    --argjson capBefore "$pre_cap" \
    --argjson capAfter "$cap" \
    --argjson capDrop "$drop_cap" \
    --argjson whDrop "$drop_wh" \
    --argjson drawW "$draw_w" \
    --arg status "$status" \
    '{startIso:$startIso,endIso:$endIso,durationSec:$durationSec,capBefore:$capBefore,capAfter:$capAfter,capDrop:$capDrop,whDrop:$whDrop,drawW:$drawW,status:$status}' >> "$SLEEP_LOG"
  rm -f "$PENDING_SLEEP"
}

FIFO="$STATE_DIR/sleep-monitor.fifo"
rm -f "$FIFO"
mkfifo "$FIFO"
gdbus monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1 2>/dev/null > "$FIFO" &
dbus_pid=$!
trap 'kill "$dbus_pid" 2>/dev/null || true; rm -f "$PID_FILE" "$FIFO"' EXIT INT TERM

while IFS= read -r line; do
  case "$line" in
    *org.freedesktop.login1.Manager.PrepareForSleep*)
      value="${line##* }"
      value="${value#*(}"
      value="${value%%)*}"
      value="${value%%,*}"
      case "$value" in
        true) snapshot_sleep ;;
        false) record_sleep ;;
      esac
      ;;
  esac
done < "$FIFO"
