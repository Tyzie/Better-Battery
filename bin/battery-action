#!/usr/bin/env bash
set -euo pipefail
DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=../lib/common.sh
source "$DIR/lib/common.sh"

cmd="${1:-}"
arg="${2:-}"

apply_profile_target() {
  local gov boost
  profile_helper_installed || return 2
  read -r gov boost <<<"$(profile_targets "$1")"
  if sudo -n "$PROFILE_HELPER" "$gov" "$boost" >/dev/null 2>&1; then return 0; fi
  if have pkexec && pkexec "$PROFILE_HELPER" "$gov" "$boost" >/dev/null 2>&1; then return 0; fi
  return 1
}

apply_profile() {
  local mode="$arg" ac effective
  case "$mode" in
    auto) touch "$AUTO_MODE_FILE" ;;
    econom|normal|power)
      rm -f "$AUTO_MODE_FILE"
      printf '%s' "$mode" > "$PROFILE_MODE_FILE"
      ;;
    *) return 1 ;;
  esac
  ac=$(ac_online)
  effective=$(profile_effective "$mode" "$ac")
  apply_profile_target "$effective" || true
}

install_profile_helper() {
  local tmpdir helper sudoers body quoted_body quoted_helper quoted_sudoers
  tmpdir=$(mktemp -d)
  helper="$tmpdir/helper"
  sudoers="$tmpdir/sudoers"
  cp "$DIR/bin/battery-profile-helper" "$helper"
  cat >"$sudoers" <<EOF
# tyzie.better-battery-fixed custom CPU profile helper
$USER_NAME ALL=(root) NOPASSWD: $PROFILE_HELPER powersave 0, $PROFILE_HELPER powersave 1, $PROFILE_HELPER performance 0, $PROFILE_HELPER performance 1
EOF
  body='
set -euo pipefail
install -Dm750 -o root -g root "$1" /usr/local/libexec/tyzie-better-battery-fixed-profile
install -Dm440 -o root -g root "$2" /etc/sudoers.d/.tyzie-better-battery-fixed.tmp
if visudo -c -f /etc/sudoers.d/.tyzie-better-battery-fixed.tmp >/dev/null 2>&1; then
  mv -f /etc/sudoers.d/.tyzie-better-battery-fixed.tmp /etc/sudoers.d/tyzie-better-battery-fixed
  chmod 440 /etc/sudoers.d/tyzie-better-battery-fixed
else
  rm -f /etc/sudoers.d/.tyzie-better-battery-fixed.tmp
  echo "sudoers validation failed" >&2
  exit 1
fi
'
  printf -v quoted_body '%q' "$body"
  printf -v quoted_helper '%q' "$helper"
  printf -v quoted_sudoers '%q' "$sudoers"
  if [ "$(id -u)" = "0" ]; then
    bash -c "$body" -- "$helper" "$sudoers"
  elif have pkexec; then
    pkexec bash -c "$body" -- "$helper" "$sudoers"
  else
    omarchy-launch-floating-terminal-with-presentation bash -lc "sudo bash -c $quoted_body -- $quoted_helper $quoted_sudoers; echo; echo Press Enter to close.; read"
  fi
  touch "$PROFILE_HELPER_MARKER"
  rm -rf "$tmpdir"
}

case "$cmd" in
  profile) apply_profile ;;
  install-profile-helper) install_profile_helper ;;
  clear-sleep)
    rm -f "$SLEEP_LOG" "$PENDING_SLEEP"
    ;;
  clear-charge)
    rm -f "$CHARGE_LOG" "$PENDING_CHARGE" "$CHARGE_STATE"
    ;;
  auto-sync)
    [ -f "$AUTO_MODE_FILE" ] || exit 0
    ac=$(ac_online)
    effective=$(profile_effective auto "$ac")
    apply_profile_target "$effective" || true
    ;;
  *) ;;
esac

exec "$DIR/bin/battery-data"
