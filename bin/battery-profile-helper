#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

usage() { echo "usage: battery-profile-helper <powersave|performance> <0|1>" >&2; exit 2; }

[ "$#" -eq 2 ] || usage
gov="$1"
boost="$2"

case "$gov" in
  powersave|performance) ;;
  *) usage ;;
esac
case "$boost" in
  0|1) ;;
  *) usage ;;
esac

[ "$(id -u)" = "0" ] || { echo "must run as root" >&2; exit 3; }

gov_path=/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
boost_path=/sys/devices/system/cpu/cpufreq/boost

for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
  [ -w "$f" ] && printf '%s' "$gov" > "$f"
done

if [ -w "$boost_path" ]; then
  printf '%s' "$boost" > "$boost_path"
fi

actual_gov=$(cat "$gov_path" 2>/dev/null || echo unknown)
actual_boost=$(cat "$boost_path" 2>/dev/null || echo -1)
printf '{"governor":"%s","boost":%s}\n' "$actual_gov" "$actual_boost"
